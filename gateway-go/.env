PORT=8887
JWT_SECRET=GatewaySecretKey-Change-This-In-Production-Min32Chars!

# Token lifetimes
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=168

# Request-log retention. Logs older than LOG_RETENTION_DAYS are purged
# automatically every LOG_CLEANUP_INTERVAL_HOURS. Set LOG_RETENTION_DAYS=0 to
# disable automatic cleanup.
LOG_RETENTION_DAYS=7
LOG_CLEANUP_INTERVAL_HOURS=6
